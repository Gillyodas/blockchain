---
config:
  layout: elk
---
erDiagram
    direction TB

    CoSoDaoTao {
        guid        Id                                      PK
        string      Ten
        string      DiaChiViCSDT
        guid        TaiKhoanId                                 "column name của TKId"
        guid        YeuCauDangKyId                         FK  "shadow — truy vết nguồn gốc"
        datetime    ThoiGianTao
        datetime    ThoiGianCapNhat
        datetime    ThoiGianXoa                                "soft delete"
        int         UyTin_Diem
        int         UyTin_SoLuongGiayPhep
        int         UyTin_SoLuongBangCapPhatHanh
        int         UyTin_SoLuongBangCapThuHoi
        int         UyTin_SoLuongBangCapBiBaoCaoGianLan
        int         UyTin_SoLuongXacMinhHopLe
        int         UyTin_HangUyTin                            "enum HangUyTin"
    }

    NhaTuyenDung {
        guid        Id                                      PK
        string      Ten
        string      DiaChi
        string      DiaChiViNhaTuyenDung
        guid        TaiKhoanId
        guid        YeuCauDangKyId                         FK  "truy vết nguồn gốc"
        datetime    ThoiGianTao
        datetime    ThoiGianCapNhat
        datetime    ThoiGianXoa                                "soft delete"
        int         HangUyTin                                  "enum HangUyTin"
    }

    SinhVien {
        guid        Id                                      PK
        string      Ten
        string      CCCD                                       "unique — nhận diện xuyên CSDT"
        string      Email
        string      DiaChiViSinhVien
        guid        TaiKhoanId                                 "column name của TKId"
        datetime    ThoiGianTao
        datetime    ThoiGianCapNhat
        datetime    ThoiGianXoa                                "soft delete khi không còn CSDT nào quản lý"
    }

    BangCap {
        guid        Id                                      PK
        string      Ten
        string      File                                       "URL file PDF — nullable"
        string      Link                                       "link chia sẻ công khai — nullable"
        double      Diem                                       "nullable"
        datetime    NgayCap
        datetime    NgayHetHan                                 "nullable"
        string      MaBamXacThuc                               "credentialHash = keccak256(data + salt) — unique"
        string      MaBamGiaoDich                              "txHash sau khi mine — nullable"
        string      Salt                                       "nullable"
        string      GhiChuHuy                                  "nullable"
        string      GhiChuThuHoi                               "nullable"
        string      GhiChuKhoiPhuc                             "nullable"
        int         LoaiBangCap                                "enum LoaiBangCap"
        int         LyDoHuyBangCap                             "enum LyDoHuy — nullable"
        int         LyDoThuHoiBangCap                          "enum LyDoThuHoi — nullable"
        int         LyDoKhoiPhucBangCap                        "enum LyDoKhoiPhuc — nullable"
        int         TrangThaiBangCapHienTai                    "enum TrangThaiBangCap"
        int         TrangThaiBlockchainHienTai                 "enum TrangThaiBlockchain"
        guid        CoSoDaoTaoCapId                        FK
        guid        SinhVienId                             FK
        guid        LinhVucId                              FK
        datetime    ThoiGianTao
        datetime    ThoiGianCapNhat
        datetime    ThoiGianXoa                                "soft delete"
    }

    LinhVuc {
        guid        Id                                      PK
        string      Ten
        datetime    ThoiGianTao
        datetime    ThoiGianCapNhat
        datetime    ThoiGianXoa
    }

    YeuCauDangKy {
        guid        Id                                      PK
        string      TenToChuc
        guid        TaiKhoanId
        int         Loai                                       "enum LoaiToChuc: Issuer | Verifier"
        int         TrangThai                                  "enum TrangThaiYeuCauDangKy"
        int         LyDo                                       "enum LyDoTuChoi — nullable"
        string      GhiChuTuChoi                               "nullable — bắt buộc khi TuChoi"
        string      GhiChuDuyet                                "nullable"
        datetime    ThoiGianTao
        datetime    ThoiGianNop                                "nullable — khi NopHoSo()"
        datetime    ThoiGianXetDuyet                           "nullable — khi Admin duyệt/từ chối"
    }

    YeuCauDangKy_GiayPhepCSDT {
        int         Id                                      PK  "shadow — auto-generated"
        string      DuongDanLuuTru
        int         LoaiGiayPhep                               "enum KieuGiayPhepCSDT"
        int         TrangThai                                  "enum TrangThaiXacMinhGiayPhep"
        datetime    ThoiGianTaiLen
        datetime    ThoiGianDuocXacMinh                        "nullable"
        datetime    ThoiGianHetHan                             "nullable"
        guid        DuocXacMinhBoiAdminId                      "nullable — FK Admin (ControlHub)"
        bool        ChuKy_CoChuKySo                            "nullable"
        bool        ChuKy_HopLe                                "nullable"
        string      ChuKy_NhaCungCap                           "nullable"
        bool        ChuKy_NhaCungCapDuocTinTuong               "nullable"
        datetime    ChuKy_NgayHetHan                           "nullable"
        datetime    ChuKy_XacMinhLuc                           "nullable"
        guid        YeuCauDangKyId                         FK
    }

    YeuCauDangKy_GiayPhepNTD {
        int         Id                                      PK  "shadow — auto-generated"
        string      DuongDanLuuTru
        int         LoaiGiayPhep                               "enum KieuGiayPhepNTD"
        int         TrangThai                                  "enum TrangThaiXacMinhGiayPhep"
        guid        YeuCauDangKyId                         FK
    }

    GiayPhepCSDT {
        int         Id                                      PK  "shadow — auto-generated"
        string      DuongDanLuuTru
        int         LoaiGiayPhep                               "enum KieuGiayPhepCSDT"
        int         TrangThai                                  "enum TrangThaiXacMinhGiayPhep"
        datetime    ThoiGianTaiLen
        datetime    ThoiGianDuocXacMinh                        "nullable"
        datetime    ThoiGianHetHan                             "nullable"
        guid        DuocXacMinhBoiAdminId                      "nullable — FK Admin (ControlHub)"
        bool        ChuKy_CoChuKySo                            "nullable"
        bool        ChuKy_HopLe                                "nullable"
        string      ChuKy_NhaCungCap                           "nullable"
        bool        ChuKy_NhaCungCapDuocTinTuong               "nullable"
        datetime    ChuKy_NgayHetHan                           "nullable"
        datetime    ChuKy_XacMinhLuc                           "nullable"
        guid        CoSoDaoTaoId                           FK
    }

    NhaTuyenDung_GiayPhepNTD {
        int         Id                                      PK  "shadow — auto-generated"
        string      DuongDanLuuTru
        int         KieuGiayPhep                               "enum KieuGiayPhepNTD"
        datetime    ThoiGianTaiLen
        datetime    ThoiGianDuocXacMinh                        "nullable"
        guid        XacMinhBoiAdminId                          "nullable — FK Admin (ControlHub)"
        guid        NhaTuyenDungId                         FK
    }

    NhatKyXacMinh {
        guid        Id                                      PK
        datetime    ThoiGianXacMinh
        string      MaBamXacMinh                               "credentialHash được xác minh"
        int         KetQuaXacMinh                              "enum KetQuaXacMinh"
        guid        NhaTuyenDungId                         FK  "nullable — null nếu xác minh công khai"
        guid        BangCapId                              FK
    }

    BaoCaoGianLan {
        guid        Id                                      PK
        int         LyDo                                       "enum LyDoBaoCaoGianLan"
        string      GhiChu                                     "nullable — bắt buộc khi LyDo = Khac"
        int         TrangThai                                  "enum TrangThaiBaoCao"
        guid        NguoiBaoCaoId                              "FK → SinhVien.Id hoặc NhaTuyenDung.Id"
        int         LoaiNguoiBaoCao                            "discriminator: SinhVien | NhaTuyenDung"
        guid        CoSoDaoTaoId                           FK  "CSDT đã cấp bằng bị báo cáo"
        guid        BangCapId                              FK
        guid        XuLyBoiAdminId                             "shadow — nullable — FK Admin (ControlHub)"
        datetime    ThoiGianBaoCao
        datetime    ThoiGianCapNhat                            "nullable"
    }

    ThongTinTuyenDung {
        guid        Id                                      PK
        string      Ten
        string      MoTa
        datetime    ThoiHanUngTuyen
        guid        NhaTuyenDungId                         FK
        guid        LinhVucId                              FK
        datetime    ThoiGianTao
        datetime    ThoiGianCapNhat
        datetime    ThoiGianXoa                                "soft delete"
    }

    KetQuaPhanTich {
        guid        Id                                      PK
        double      PhanTramPhuHop
        json        KetLuan                                    "điểm mạnh, điểm thiếu, đề xuất"
        datetime    ThoiGianPhanTich
        guid        ThongTinTuyenDungId                    FK
        guid        HoSoUngTuyenId                         FK
    }

    HoSoUngTuyen {
        guid        Id                                      PK
        int         TrangThaiUngTuyenHienTai                   "enum TrangThaiUngTuyen"
        datetime    ThoiGianUngTuyen
        datetime    ThoiGianCapNhat                            "nullable"
        datetime    ThoiGianXoa                                "nullable — soft delete"
        guid        SinhVienId                             FK
        guid        ThongTinTuyenDungId                    FK
    }

    BangCapUngTuyen {
        guid        HoSoUngTuyenId                         PK,FK
        guid        BangCapId                              PK,FK
    }

    YeuCauDangKy        ||--o{    YeuCauDangKy_GiayPhepCSDT  : "đính kèm (CSDT)"
    YeuCauDangKy        ||--o{    YeuCauDangKy_GiayPhepNTD   : "đính kèm (NTD)"
    YeuCauDangKy        ||--o|    CoSoDaoTao                 : "tạo ra"
    YeuCauDangKy        ||--o|    NhaTuyenDung               : "tạo ra"
    CoSoDaoTao          ||--o{    GiayPhepCSDT               : "sở hữu"
    NhaTuyenDung        ||--o{    NhaTuyenDung_GiayPhepNTD   : "sở hữu"
    CoSoDaoTao          ||--o{    BangCap                    : "cấp"
    SinhVien            ||--o{    BangCap                    : "được cấp"
    LinhVuc             ||--o{    BangCap                    : "phân loại"
    LinhVuc             ||--o{    ThongTinTuyenDung          : "phân loại"
    NhaTuyenDung        ||--o{    NhatKyXacMinh              : "thực hiện"
    BangCap             ||--o{    NhatKyXacMinh              : "được xác minh"
    BangCap             ||--o{    BaoCaoGianLan              : "bị báo cáo"
    CoSoDaoTao          ||--o{    BaoCaoGianLan              : "liên quan"
    NhaTuyenDung        ||--o{    ThongTinTuyenDung          : "đăng"
    ThongTinTuyenDung   ||--o{    KetQuaPhanTich             : "có nhiều lần phân tích"
    HoSoUngTuyen        ||--o{    KetQuaPhanTich             : "được phân tích"
    SinhVien            ||--o{    HoSoUngTuyen               : "nộp"
    ThongTinTuyenDung   ||--o{    HoSoUngTuyen               : "nhận"
    HoSoUngTuyen        ||--|{    BangCapUngTuyen            : "gồm"
    BangCap             ||--o{    BangCapUngTuyen            : "được đính kèm"
